# SyncBoard - Environment Variables
# Copy these values into backend/.env for local development.
# For Railway, add these in the Railway Variables dashboard.

# Database
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Railway SQLite with volume (example):
# DATABASE_URL="file:/data/dev.db"

# Security
JWT_SECRET="replace-with-a-long-random-secret"

# Runtime
NODE_ENV="development"
PORT=8081

# CORS (comma-separated origins supported)
CLIENT_URL="http://localhost:5173"
# Example production:
# CLIENT_URL="https://your-app.up.railway.app"

# Optional admin seed values
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin1234"
ADMIN_NAME="Admin User"
