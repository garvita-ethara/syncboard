# SyncBoard - Environment Configuration Reference
# Copy these values into backend/.env for local development.
# For Railway production, use the Railway Variables dashboard.

# --- Database ---
# Local PostgreSQL:
DATABASE_URL="postgresql://user:password@localhost:5432/syncboard?schema=public"
# Railway PostgreSQL (Auto-injected by Railway):
# DATABASE_URL="postgresql://postgres:password@host:port/railway"

# --- Security ---
# Required for production sessions
JWT_SECRET="replace-with-a-very-long-and-random-secret-key"

# --- Runtime ---
NODE_ENV="production"
PORT=8080

# --- CORS ---
# Local development
CLIENT_URL="http://localhost:5173"
# Production (Comma-separated origins allowed)
# CLIENT_URL="https://syncboard-production.up.railway.app"

# --- Optional Admin Seed ---
# These are used during 'npm run db:seed'
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="SyncBoard Admin"
