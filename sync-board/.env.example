# SyncBoard - Environment Configuration Reference
# Copy these values into backend/.env for local development.
# For Railway production, replace DATABASE_URL with your Railway PostgreSQL URL.

# --- Database ---
# Local development (bundled SQLite database):
DATABASE_URL="file:./dev.db"
# Railway PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@host:port/railway"

# --- Security ---
# Required for production sessions
JWT_SECRET="replace-with-a-very-long-and-random-secret-key"

# --- Runtime ---
NODE_ENV="development"
PORT=8082

# --- CORS ---
# Local development
CLIENT_URL="http://localhost:5173"
# Production (Comma-separated origins allowed)
# CLIENT_URL="https://syncboard-production.up.railway.app"

# --- Optional Admin Seed ---
# These are used during 'npm run db:seed'
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="Admin@123!"
ADMIN_NAME="SyncBoard Admin"
